# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# --- Routing backend (Valhalla) ---
FT_VALHALLA_URL=https://your-valhalla-host.example
FT_VALHALLA_USER=
FT_VALHALLA_PASS=
# Set to 1 when the backend is behind an ngrok tunnel (adds the skip-warning header).
FT_VALHALLA_NGROK=1

# --- Feed API keys ---
# Reference Open511 (511 SF Bay): https://511.org/open-data/token
FT_SF511_API_KEY=

# IBI511 / Travel-IQ platform keys (one key per state portal you register with).
# Register at each state's /developers page, e.g. https://511ny.org/developers
FT_IBI511_NY_KEY=
FT_IBI511_FL_KEY=
FT_IBI511_GA_KEY=
FT_IBI511_UT_KEY=
FT_IBI511_NHMEVT_KEY=

# State DOT keys (WSDOT travel times + flow). Free: https://wsdot.wa.gov/traffic/api/
FT_WSDOT_API_KEY=

# Freemium probe-traffic key (live lookups only -- do NOT cache/redistribute per ToS).
# Free tier: https://developer.tomtom.com/
FT_TOMTOM_API_KEY=

# GTFS-Realtime VehiclePositions feeds are mostly keyless; some agencies require
# a key/token in the URL or a header -- configure per agency in your own code.
